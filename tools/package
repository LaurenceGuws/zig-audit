#!/usr/bin/env python3
"""Create a deterministic pinned-source zig-audit package and digest manifest."""

from __future__ import annotations

import argparse
import hashlib
import io
import json
import os
from pathlib import Path
import re
import subprocess
import struct
import tarfile


def sha256(data: bytes) -> str:
    return hashlib.sha256(data).hexdigest()


def identity(binary: Path) -> dict:
    outputs = []
    for alias in ("-v", "--version"):
        result = subprocess.run([binary, alias], text=True, capture_output=True, check=True, timeout=10)
        if result.stderr:
            raise SystemExit(f"version probe {alias} wrote stderr")
        outputs.append(json.loads(result.stdout))
    if outputs[0] != outputs[1]:
        raise SystemExit("-v and --version identities differ")
    value = outputs[0]
    if set(value) != {"schema", "version", "stable_ruleset"} or value["schema"] != "zig-audit.version/v1":
        raise SystemExit("binary does not expose zig-audit.version/v1")
    return value


def native_target() -> str:
    machine = os.uname().machine
    return {"x86_64": "x86_64-linux", "aarch64": "aarch64-linux"}[machine]


def elf_target(path: Path) -> str:
    with path.open("rb") as stream:
        raw = stream.read(20)
    if len(raw) < 20 or raw[:4] != b"\x7fELF" or raw[4] != 2 or raw[5] != 1:
        raise SystemExit("cross-build artifact is not a 64-bit little-endian ELF")
    arch = struct.unpack_from("<H", raw, 18)[0]
    if arch not in (62, 183):
        raise SystemExit(f"unsupported cross-build ELF machine {arch}")
    return {62: "x86_64-linux", 183: "aarch64-linux"}[arch]


def add_bytes(archive: tarfile.TarFile, name: str, data: bytes, mode: int) -> None:
    info = tarfile.TarInfo(name)
    info.size = len(data)
    info.mode = mode
    info.mtime = 0
    info.uid = info.gid = 0
    info.uname = info.gname = ""
    archive.addfile(info, io.BytesIO(data))


def main() -> None:
    parser = argparse.ArgumentParser()
    parser.add_argument("--binary", type=Path, required=True)
    parser.add_argument("--target", choices=("x86_64-linux", "aarch64-linux"), required=True)
    parser.add_argument("--revision", required=True, help="full source Git SHA selected by the builder")
    parser.add_argument("--identity-from", type=Path, help="native companion binary built from the same source for cross packages")
    parser.add_argument("--output", type=Path, required=True)
    args = parser.parse_args()

    if not re.fullmatch(r"[0-9a-f]{40}", args.revision):
        raise SystemExit("full source Git revision is required")
    binary = args.binary.resolve(strict=True)
    target = args.target
    if target == native_target():
        if args.identity_from is not None:
            raise SystemExit("--identity-from is only valid for cross-target packaging")
        ident = identity(binary)
    else:
        if args.identity_from is None:
            raise SystemExit("cross-target package requires --identity-from native companion")
        actual = elf_target(binary)
        if actual != target:
            raise SystemExit(f"ELF target mismatch: expected {target}, got {actual}")
        ident = identity(args.identity_from.resolve(strict=True))
    version = ident["version"]
    output = args.output.resolve()
    output.mkdir(mode=0o700, parents=True, exist_ok=False)
    binary_bytes = binary.read_bytes()
    package = {
        "schema": "zig-audit.package/v2",
        "package": "zig-audit",
        "version": version,
        "target": target,
        "revision": args.revision,
        "binary_sha256": sha256(binary_bytes),
        "stable_ruleset": ident["stable_ruleset"],
    }
    package_bytes = (json.dumps(package, sort_keys=True, separators=(",", ":")) + "\n").encode()
    stem = f"zig-audit-{version}-{target}"
    artifact = output / f"{stem}.tar.xz"
    with tarfile.open(artifact, mode="w:xz", format=tarfile.PAX_FORMAT) as archive:
        add_bytes(archive, "package.json", package_bytes, 0o600)
        add_bytes(archive, "bin/zig-audit", binary_bytes, 0o700)
    artifact_bytes = artifact.read_bytes()
    manifest = {
        "schema": "zig-audit.artifact-manifest/v1",
        "package": "zig-audit",
        "version": version,
        "target": target,
        "revision": args.revision,
        "archive": {
            "name": artifact.name,
            "size": len(artifact_bytes),
            "sha256": sha256(artifact_bytes),
        },
    }
    manifest_path = output / f"{stem}.json"
    manifest_path.write_text(json.dumps(manifest, sort_keys=True, separators=(",", ":")) + "\n")
    print(json.dumps({
        "schema": "zig-audit.package-build/v1",
        "artifact": str(artifact),
        "manifest": str(manifest_path),
        "version": version,
        "target": target,
        "revision": args.revision,
        "size": len(artifact_bytes),
        "sha256": manifest["archive"]["sha256"],
    }, sort_keys=True, separators=(",", ":")))


if __name__ == "__main__":
    main()
